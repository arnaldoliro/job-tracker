NODE_ENV=development
PORT=3333
# Só a máquina local. A API não tem autenticação: 0.0.0.0 a expõe na rede.
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000

# Infra local (docker compose up -d na raiz)
DATABASE_URL=postgresql://recruit:recruit@localhost:5432/recruit
REDIS_URL=redis://localhost:6379

# Claude — deixe vazio até a feature de IA existir
ANTHROPIC_API_KEY=

# Email (IMAP). Use app password, nunca a senha principal da conta.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Rótulo do Gmail que o app lê. Crie um filtro que marque emails de ATS com ele
# — assim o app nunca enxerga o resto da sua caixa.
IMAP_MAILBOX=job-tracker
# Sincronizar ao subir. Deixe false em desenvolvimento: o --watch reinicia a
# cada arquivo salvo, e cada reinício abriria uma conexão IMAP.
IMAP_SYNC_ON_BOOT=false
