NODE_ENV=development
PORT=3333
# Só a máquina local. A API não tem autenticação: 0.0.0.0 a expõe na rede.
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000

# Infra local (docker compose up -d na raiz)
DATABASE_URL=postgresql://recruit:recruit@localhost:5432/recruit

# Claude. Opcional: sem ela ficam desligadas as tarefas de IA que estiverem em
# `anthropic` abaixo — sugestão de status pelo email, "Resolver por IA",
# extração de vaga por link e respostas de formulário. O resto do app funciona
# igual. Precisa de crédito na conta: chave sem saldo responde erro, não
# resultado.
ANTHROPIC_API_KEY=

# Quem atende cada tarefa de IA: `anthropic` (a chave acima) ou `local` (um
# modelo rodando nesta máquina, pelo Ollama). Padrão: anthropic em todas.
# Leitura de email e extração de vaga funcionam bem num modelo local de 3–4B;
# as respostas de formulário são escrita, e um modelo pequeno escreve bem
# pior — vale manter essa na Anthropic.
AI_EMAIL_PROVIDER=anthropic
AI_RESOLVE_PROVIDER=anthropic
AI_EXTRACTION_PROVIDER=anthropic
AI_ANSWERS_PROVIDER=anthropic
# Ollama. Só nesta máquina (127.0.0.1, localhost ou [::1]); outro endereço é
# recusado, porque o modelo local existe para o currículo e os emails não
# saírem daqui. Nada é enviado a lugar nenhum quando uma tarefa é `local`.
AI_LOCAL_URL=http://127.0.0.1:11434
# O modelo, como em `ollama pull <nome>`. Obrigatório se alguma tarefa é
# `local`. Numa GPU de 4 GB: qwen2.5:3b ou llama3.2:3b.
AI_LOCAL_MODEL=
# Modelo só para as respostas de formulário, se quiser um maior para escrever.
AI_LOCAL_WRITING_MODEL=
# Por chamada, em milissegundos. Modelo na CPU pode passar de um minuto.
AI_LOCAL_TIMEOUT_MS=120000
# Janela de contexto. Acima dela o Ollama CORTA o prompt em silêncio; o app
# limita o texto por esta conta. 8192 cabe em 4 GB com um modelo de 3B;
# extração de vaga e respostas de formulário ficam melhores com 16384.
AI_LOCAL_NUM_CTX=8192

# Email (IMAP). Use app password, nunca a senha principal da conta.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Rótulo do Gmail que o app lê. Crie um filtro que marque emails de ATS com ele
# — assim o app nunca enxerga o resto da sua caixa.
IMAP_MAILBOX=job-tracker
# Sincronizar ao subir o backend — a única sincronização sem clique; depois,
# só pelo botão "Sincronizar agora". Use false com o --watch, que reinicia a
# cada arquivo salvo e abriria uma conexão IMAP por gravação.
IMAP_SYNC_ON_BOOT=true

# Boards públicos de empresas que a descoberta de vagas lê, separados por
# vírgula. O slug é a parte do endereço: boards.greenhouse.io/<slug>,
# jobs.ashbyhq.com/<slug>, jobs.lever.co/<slug>. Vazio é válido: Gupy,
# agregadores remotos, portais brasileiros e alertas do LinkedIn funcionam sem
# lista. Exemplo (fictício): DISCOVERY_GREENHOUSE_BOARDS=empresa-um,empresa-dois
DISCOVERY_GREENHOUSE_BOARDS=
DISCOVERY_ASHBY_BOARDS=
DISCOVERY_LEVER_BOARDS=
