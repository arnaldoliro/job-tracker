# Copie para .env.local
# URL da API do Nest. Server-only: não é NEXT_PUBLIC porque o navegador
# nunca chama a API direto — quem chama é o servidor do Next.
# 127.0.0.1 e não localhost: a API escuta só em IPv4, e em sistemas onde
# localhost resolve primeiro para ::1 o front não a encontraria.
API_URL=http://127.0.0.1:3333
